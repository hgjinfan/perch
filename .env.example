# Copy this file to .env. Keep actual credentials out of Git.
ADMIN_USERNAME=admin
# Leave empty to disable /admin; set your own strong password before enabling it.
ADMIN_PASSWORD=
TRUST_PROXY_HOPS=0
WEATHER_RATE_LIMIT=60
CITY_SEARCH_RATE_LIMIT=20
WEATHER_CONCURRENCY=4
# Shared upstream budget for all sources and administrator previews.
UPSTREAM_CONCURRENCY=8
UPSTREAM_PER_ORIGIN=2
UPSTREAM_MAX_QUEUE=24
UPSTREAM_QUEUE_WAIT_MS=2000
UPSTREAM_TIMEOUT_MS=8000
# Optional data-source secrets; Docker Compose also needs an explicit environment entry.
# WIDGET_IMMICH_TOKEN=
# WIDGET_GITHUB_TOKEN=
# WIDGET_GITEA_TOKEN=
# WIDGET_NEZHA_TOKEN=
# WIDGET_NEZHA_LEGACY_TOKEN=
